NETWORKS = [
    "162.159.192.",
    "162.159.193.",
    "188.114.96.",
    "188.114.97.",
]

MASQUE_PORTS = [443, 8443, 4443, 4500]


def generate_candidates():
    result = []
    for net in NETWORKS:
        for i in range(1, 33):
            for port in MASQUE_PORTS:
                result.append({
                    "server": f"{net}{i}",
                    "port": port,
                    "mode": "masque",
                })
    return result


def scan_endpoints():
    candidates = generate_candidates()
    print(f"[WARP MASQUE SCANNER] Generated {len(candidates)} endpoints")
    return candidates
