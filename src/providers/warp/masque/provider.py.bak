import json
from .checker import check_masque
from .register import get_or_register_masque
from .scanner import scan_endpoints


class MasqueProvider:

  def generate_nodes(self):
    account = get_or_register_masque()
    if not account:
      print("[WARP MASQUE] No account, skipping")
      return []

    candidates = scan_endpoints()
    print(f"[WARP MASQUE] Scanning {len(candidates)} endpoints...")

    nodes = []
    for target in candidates:
      node = {
          "name": f"[WARP MASQUE] {target['server']}:{target['port']}",
          "type": "masque",
          "server": target["server"],
          "port": target["port"],
          "private-key": account["private_key"],
          "public-key": account["edge_public_key"],
          "ip": account["ipv4"],
          "ipv6": account.get("ipv6", ""),
          "uri": "https://cloudflareaccess.com",
          "sni": "consumer-masque.cloudflareclient.com",
          "mtu": 1280,
          "udp": True,
          "network": "quic",
          "remote-dns-resolve": True,
      }
      nodes.append(node)

    print(f"[WARP MASQUE] Generated {len(nodes)} node candidates")
    return nodes
