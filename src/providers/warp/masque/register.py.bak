import base64
import json
import os
import subprocess
import urllib.error
import urllib.request
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parents[4]
CACHE_DIR = BASE_DIR / "cache" / "warp"
CACHE_FILE = CACHE_DIR / "masque-account.json"
API_URL = "https://api.cloudflareclient.com/v0i1909051800/reg"


def generate_wireguard_keypair():
  """Генерирует пару ключей Curve25519 для Cloudflare WARP."""
  # 1. Пробуем через wg
  try:
    priv = subprocess.check_output(
        ["wg", "genkey"], stderr=subprocess.DEVNULL
    ).strip()
    pub = subprocess.check_output(
        ["wg", "pubkey"], input=priv, stderr=subprocess.DEVNULL
    ).strip()
    return priv.decode("utf-8"), pub.decode("utf-8")
  except Exception:
    pass

  # 2. Пробуем через python cryptography
  try:
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric import x25519

    priv_key = x25519.X25519PrivateKey.generate()
    pub_key = priv_key.public_key()

    priv_b64 = base64.b64encode(
        priv_key.private_bytes(
            encoding=serialization.Encoding.Raw,
            format=serialization.PrivateFormat.Raw,
            encryption_algorithm=serialization.NoEncryption(),
        )
    ).decode("utf-8")

    pub_b64 = base64.b64encode(
        pub_key.public_bytes(
            encoding=serialization.Encoding.Raw,
            format=serialization.PublicFormat.Raw,
        )
    ).decode("utf-8")

    return priv_b64, pub_b64
  except Exception:
    pass

  # 3. Fallback через openssl pkey
  try:
    priv_pem = subprocess.check_output(
        ["openssl", "genpkey", "-algorithm", "x25519"],
        stderr=subprocess.DEVNULL,
    )

    # Извлекаем сырые байты приватного ключа
    priv_der = subprocess.check_output(
        ["openssl", "pkey", "-outform", "DER"],
        input=priv_pem,
        stderr=subprocess.DEVNULL,
    )
    priv_bytes = priv_der[-32:]

    # Извлекаем сырые байты публичного ключа
    pub_der = subprocess.check_output(
        ["openssl", "pkey", "-pubout", "-outform", "DER"],
        input=priv_pem,
        stderr=subprocess.DEVNULL,
    )
    pub_bytes = pub_der[-32:]

    return base64.b64encode(priv_bytes).decode("utf-8"), base64.b64encode(
        pub_bytes
    ).decode("utf-8")
  except Exception as e:
    raise RuntimeError(
        "Не удалось сгенерировать X25519 ключ. Установите wireguard-tools"
        " (apt install wireguard-tools) или pip install cryptography"
    ) from e


def register_masque():
  CACHE_DIR.mkdir(parents=True, exist_ok=True)
  priv_key, pub_key = generate_wireguard_keypair()

  payload = {
      "key": pub_key,
      "install_id": "",
      "fcm_token": "",
      "tos": "2024-01-01T00:00:00.000Z",
      "model": "PC",
      "type": "Linux",
      "locale": "en_US",
  }

  req = urllib.request.Request(
      API_URL,
      data=json.dumps(payload).encode("utf-8"),
      headers={
          "Content-Type": "application/json; charset=UTF-8",
          "User-Agent": "okhttp/3.12.1",
      },
      method="POST",
  )

  try:
    with urllib.request.urlopen(req, timeout=10) as resp:
      data = json.loads(resp.read().decode("utf-8"))
      account_data = {
          "id": data["result"]["id"],
          "token": data["result"]["token"],
          "private_key": priv_key,
          "public_key": pub_key,
          "edge_public_key": data["result"]["config"]["peers"][0]["public_key"],
          "ipv4": (
              data["result"]["config"]["interface"]["addresses"]["v4"] + "/32"
          ),
          "ipv6": (
              data["result"]["config"]["interface"]["addresses"]["v6"] + "/128"
          ),
      }
      with open(CACHE_FILE, "w", encoding="utf-8") as f:
        json.dump(account_data, f, indent=2)
      print("[WARP MASQUE] Registered new MASQUE account successfully!")
      return account_data
  except urllib.error.HTTPError as e:
    print(
        f"[WARP MASQUE] HTTP {e.code}:"
        f" {e.read().decode('utf-8', errors='ignore')}"
    )
    return None
  except Exception as e:
    print(f"[WARP MASQUE] Registration failed: {e}")
    return None


def get_or_register_masque():
  if CACHE_FILE.exists():
    with open(CACHE_FILE, encoding="utf-8") as f:
      return json.load(f)
  return register_masque()
